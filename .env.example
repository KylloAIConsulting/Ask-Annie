# OpenAI — required when USE_MOCK_AI is not true (Sprint 3+)
OPENAI_API_KEY=

# OpenAI model to use (defaults to gpt-5.6-terra when unset)
OPENAI_MODEL=gpt-5.6-terra

# Set to true to use mock AI responses — no API key required (Sprint 1 & 2 default)
USE_MOCK_AI=true

# Application environment
NODE_ENV=development

# ── Development-only fixture mode ─────────────────────────────────────────
# Set VITE_USE_FIXTURE=true to bypass the real API and return fixture data
# instead. Fixture mode is for local development only — it is never active
# in production because the client guards it with import.meta.env.DEV.
#
# Valid values for VITE_FIXTURE_RISK_LEVEL: LOWER_RISK | CONCERNING | HIGH_RISK
# Defaults to LOWER_RISK when unset or set to an unrecognised value.
VITE_USE_FIXTURE=false
VITE_FIXTURE_RISK_LEVEL=LOWER_RISK
